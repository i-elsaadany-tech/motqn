{
  "name": "motqn-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Motqn Assessment - skill-level analysis of student exam results with individual reports (AR/EN)",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "npx http-server dist -p 8080 -c-1",
    "android:setup": "bash tools/android-setup.sh",
    "android:aab": "bash tools/android-setup.sh && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=22" }
}
